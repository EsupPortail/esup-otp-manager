script#user-view(type='text/x-template').
    <div v-if="user.uid">
      <h2 class="h3">{{user.name ? `${user.name} (${user.uid})` : user.uid}}</h2>
      <button v-if="Object.keys(methods).some(method => user.methods[method].active)" class="waves-effect waves-light btn red darken-1" @click="deactivateAllMethods">{{messages.manager.deactivateAllMethods}}<i class="material-icons right" aria-hidden="true">delete_forever</i></button>
      <ul>
        <template v-for="method in methods">
          <li v-if="user.methods[method.name] && methods[method.name].activate">
            <h3 class="h4">{{method.label}}</h3>
            <div class='switch'>
              <label>
                {{messages.api.action.deactivate}}
                <input type='checkbox' :id="method.name+'_switch'" @click.prevent="user.methods[method.name].active ? deactivate(method.name) : activate(method.name)" :name="method.name" role="switch" :aria-label="method.label" :checked="user.methods[method.name].active && !user.methods[method.name].askActivation"/>
                <span class='lever'></span>
                {{messages.api.action.activate}}
              </label>
            </div>
            <div v-if="user.methods[method.name].active">
              <component :is=method.name :method=method.name :methods=methods :reset_push=confirmResetPush :reset_totp=confirmResetTotp :reset_bypass=confirmResetBypass :reset_passcode_grid=confirmResetPasscodeGrid :hasValidTransportForRandom_codeMethod=hasValidTransportForRandom_codeMethod :fetchWebauthnData=fetchWebauthnData :get-and-set-user=getAndSetUser :messages=messages :infos=infos :user.sync=user :formatApiUri=formatApiUri :isManager=true></component>
            </div>
            <div class="divider"></div>
          </li>
        </template>
      </ul>
    </div>
