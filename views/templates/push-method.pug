script#push-method(type='text/x-template').
    <div>
      <div class="card" v-if="user.methods.push.askActivation">
        <div class="row" style="margin-bottom: 0;">
          <div class="col s1 m2"><span class="white-text"></span></div>
          <p class="col s10 m8 center-align">
            <p v-html="messages.api.methods.push.esup_Auth_installation_instructions.replace('%ESUP_AUTH%', infos.esup_auth_download_link)"></p>
            <p v-if="user.methods.push.deepLink && infos.mobile" v-html="messages.api.methods.push.deeplink_instructions.replace('%DEEPLINK%', user.methods.push.deepLink)"/>
            <template v-else>
              <p v-html="messages.api.methods.push.qrcode_instructions"/>
              <p class="push-qrcode" v-html="user.methods.push.qrCode"/>
            </template>
          </p>
        </div>
        <div class="card-action">
          <div class="row" style="margin-bottom: 0;">
            <div class="col s1 m2"><span class="white-text"></span></div>
            <div class="col s10 m8">
              <p v-html='
                messages.api.methods.push.manual_activation_instructions
                    .join("\n")
                    .replace("%UID%", user.uid)
                    .replace("%ACTIVATION_CODE%", user.methods.push.activationCode)
                    .replace("%API_URL%", user.methods.push.api_url)
              '></p>
            </div>
          </div>
          <div class="row center-align" style="margin-bottom: 0;" v-if="canAddPushBrowser">
            <button type="button" class="waves-effect waves-light btn" @click="addPushBrowser">
              <i class="material-icons left" aria-hidden="true">computer</i>
              {{messages.api.methods.push.add_browser}}
            </button>
          </div>
        </div>
      </div>
      <div class="card" v-else-if="user.methods.push.askBrowserActivation">
        <div class="row" style="margin-bottom: 0;">
          <div class="col s1 m2"><span class="white-text"></span></div>
          <div class="col s10 m8 center-align">
            <div class="preloader-wrapper small active" aria-hidden="true">
              <div class="spinner-layer spinner-blue-only">
                <div class="circle-clipper left"><div class="circle"></div></div>
                <div class="gap-patch"><div class="circle"></div></div>
                <div class="circle-clipper right"><div class="circle"></div></div>
              </div>
            </div>
            <p>{{messages.api.methods.push.browser_activation_instructions}}</p>
          </div>
        </div>
      </div>
      <div v-else>
        <div class="row" style="margin-bottom: 0;" v-for="(device, index) in (user.methods.push.devices || (user.methods.push.device ? [user.methods.push.device] : []))" :key="device.id || index">
          <div class="col s1 m2">
            <span class="white-text"></span>
          </div>
          <div class="col s10 m8">
            <div class="card-panel grey lighten-3">
              <div class="row valign-wrapper" style="margin-bottom: 0;">
                <div class="col s3">
                  <img :src="device.type === 'browser' ? 'images/web_push.svg' : 'images/icon-smartphone.svg'" alt="">
                </div>
                <p class="col s7 no-margin">
                  {{device.platform}}<br>
                  {{device.manufacturer}}<br>
                  {{device.model}}
                </p>
                <div class="col s2 right-align">
                  <button v-if="device.id" type="button" class="waves-effect waves-light btn red darken-1" @click="deletePushDevice(device)" :title="messages.api.action.remove">
                    <i class="material-icons" aria-hidden="true">delete</i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="row center-align" style="margin-bottom: 0;" v-if="canAddPushBrowser">
          <button type="button" class="waves-effect waves-light btn" @click="addPushBrowser">
            <i class="material-icons left" aria-hidden="true">computer</i>
            {{messages.api.methods.push.add_browser}}
          </button>
        </div>
      </div>
      <div role="list" lang="fr">
        <a role="listitem" target="_blank" title="Esup Auth - Disponible sur Google Play pour Android" href="https://play.google.com/store/apps/details?id=org.esupportail.esupAuth">
          <img width="150px" src="images/play-store.png" alt="Disponible sur Google Play"/>
        </a>
        <a role="listitem" target="_blank" title="Esup Auth - Télécharger dans l'App Store pour IOS" href="https://apps.apple.com/fr/app/esup-auth/id1563904941">
          <img width="150px" src="images/app-store.png" alt="Télécharger dans l'App Store"/>
        </a>
      </div>
    </div>
