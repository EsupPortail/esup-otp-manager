script#user-dashboard(type='text/x-template').
   <div>
     <template v-for="method in methods">
      <div class="section method-section" v-if="method.activate && currentmethod==method.name" autofocus aria-live="assertive">
         <div class="method-header">
            <h2 class="h3">{{method.label || method.name}}</h2>
            <p>
               {{messages.api.methods[method.name].description}}
            </p>
         </div>
        <div class='switch'>
          <label>
            {{messages.api.home.deactivated}}
            <input type='checkbox' :id="method.name+'_switch'" @click.prevent="user.methods[method.name].active ? deactivate(method.name) : activate(method.name)" :name="method.name" role="switch" :aria-label="method.label" :checked="user.methods[method.name].active && !user.methods[method.name].askActivation"/>
            <span class='lever' :class="{ askActivation: user.methods[method.name].askActivation }"></span>
            {{ messages.api.home.activated }}
          </label>
          <p v-if="user.methods[method.name].askActivation" class="grey-text text-darken-1" style="margin-top: 0">{{ messages.api.home.help_if_activating }}</p>
          <p v-else-if="user.methods[method.name].active"   class="grey-text text-darken-1" style="margin-top: 0">{{ messages.api.home.help_if_active     }}</p>
          <p v-else                                         class="grey-text text-darken-1" style="margin-top: 0">{{ messages.api.home.help_if_inactive   }}</p>
        </div>
         <div class="divider"></div>
         <div class="method-component-wrapper" v-if="user.methods[method.name].active">
            <component :is=currentmethod :method=currentmethod :methods=methods :reset_push=confirmResetPush :reset_totp=confirmResetTotp :reset_bypass=confirmResetBypass :reset_passcode_grid=confirmResetPasscodeGrid :hasValidTransportForRandom_codeMethod=hasValidTransportForRandom_codeMethod :fetchWebauthnData=fetchWebauthnData :get-and-set-user=getAndSetUser :activate=activate :messages=messages :infos=infos :user=user :formatApiUri=formatApiUri :isManager=false></component>
         </div>
      </div>
     </template>
   </div>
